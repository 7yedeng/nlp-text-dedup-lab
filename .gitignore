# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 大型模型文件（不随仓库分发，获取方式见 README）----
model/

# ---- 打包产物 / 临时文件 ----
*.zip
*.tar.gz
*.7z
~$*

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 审计过程产物（本地核对用，不入库）----
# 修订前的原始落盘结果与完整运行日志，仅用于本地逐行 diff；
# 结论已整理进 out/AUDIT_NOTES.md，需要时可用 README 中的命令重新生成。
out/_baseline_original/
out/_repro_logs/

# ---- 外部审计输入留档（本地参考）----
_audit_input/

# ---- 个人信息保护：以下内容只在本地生成，不入公开仓库 ----
# 学校提交材料（文件名含真实姓名学号）与本地生成的报告
提交材料/
# 含真实署名的报告不入库；无署名的占位版本例外放行（内容与脱敏版一致，供公开查看）
out/*第1次实验报告*.docx
!out/成员一+成员二+第1次实验报告.docx
# 本地署名 / 班期等个人信息
.env
local_env.ps1
